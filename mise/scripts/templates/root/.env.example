# Example environment variables for ${PROJECT_NAME} (slug: ${SLUG})
# Copy this file to ".env" and fill in the values. Do NOT commit your filled-in ".env".
#
# Kaggle authentication:
# - You can either set KAGGLE_USERNAME and KAGGLE_KEY here, or place ~/.kaggle/kaggle.json (0600).
# - The tools will prefer environment variables when both are present.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional integrations:
# - Weights & Biases API key (if you use wandb)
WANDB_API_KEY=
