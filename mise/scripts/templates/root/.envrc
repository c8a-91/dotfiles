# direnv configuration for ${PROJECT_NAME} (slug: ${SLUG})
# Auto-activate .venv and show project name in prompt
# Generated by 'mise run kaggle:init ${SLUG}'

# Determine project name and venv location
PRJ_NAME="$(basename "$PWD")"
VENV_DIR="$PWD/.venv"

# Activate the project's .venv if it exists
if [ -d "$VENV_DIR" ]; then
  # Create a hidden alias path embedding the project name so prompts show "(<project>)"
  ALIAS_DIR="$PWD/.venv-names"
  mkdir -p "$ALIAS_DIR"
  ln -sfn "$VENV_DIR" "$ALIAS_DIR/$PRJ_NAME"

  # Point VIRTUAL_ENV to the alias path for nice prompt names
  export VIRTUAL_ENV="$ALIAS_DIR/$PRJ_NAME"

  # Use the real bin path for execution
  PATH_add "$VENV_DIR/bin"
fi

# Load environment variables from .env if available
if declare -F dotenv >/dev/null 2>&1; then
  if [ -f ".env" ]; then
    dotenv
  fi
elif [ -f ".env" ]; then
  # Fallback: export simple KEY=VALUE lines (best-effort)
  # shellcheck disable=SC2046
  export $(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' .env | cut -d= -f1) >/dev/null 2>&1 || true
fi

# Watch files to trigger reloads
watch_file .env
watch_file pyproject.toml
